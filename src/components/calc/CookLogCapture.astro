---
/*
 * Cook-log capture UI. Included once inside StallPredictor.astro (shared
 * across all four protein stall pages). All the state-machine logic
 * (consent -> start -> checkpoints) lives in ./cookLogCapture.controller.js;
 * this file is just the markup for each mutually-exclusive panel.
 *
 * Consent copy below is a DRAFT — flagged in the PR description as pending
 * Mike's final wording before this ships broadly.
 */
---

<div class="rounded-2xl bg-slate-900 ring-1 ring-slate-800 shadow-xl shadow-black/40 p-5 sm:p-6 space-y-4" data-cook-log-capture>
  <div class="flex items-center gap-2">
    <span class="text-xl" aria-hidden="true">📊</span>
    <h3 class="text-sm font-semibold text-white">Cook Log</h3>
    <span class="text-[10px] font-mono uppercase tracking-widest text-slate-600">Beta</span>
  </div>

  <!-- Consent: undecided -->
  <div id="cookLogConsentPrompt" hidden class="space-y-3">
    <p class="text-[12px] text-slate-400 leading-relaxed">
      Help improve this model: opt in to log this cook's weight, timeline, and predicted vs.
      actual cook time. Anonymous beyond altitude — no name, email, or precise location, just a
      random id stored on this device. Used only for a periodic, human-reviewed check on whether
      these models need retuning.
    </p>
    <div class="flex gap-2">
      <button id="cookLogOptIn" type="button" class="rounded-lg bg-amber-500 hover:bg-amber-400 text-base-900 font-bold text-xs px-4 py-2 transition-colors">
        Opt in
      </button>
      <button id="cookLogOptOut" type="button" class="rounded-lg bg-slate-800 ring-1 ring-slate-700 hover:ring-slate-600 text-slate-300 hover:text-white font-semibold text-xs px-4 py-2 transition-all">
        No thanks
      </button>
    </div>
  </div>

  <!-- Consent: denied — a single small, non-nagging way back in -->
  <p id="cookLogDeniedLink" hidden class="text-[12px] text-slate-500">
    Cook logging is off.
    <button id="cookLogEnableLink" type="button" class="text-amber-400 hover:text-amber-300 underline underline-offset-2">Turn it on</button>
  </p>

  <!-- Opted in, no active cook -->
  <form id="cookLogStartForm" hidden class="space-y-3">
    <div>
      <label for="cookLogWeightSource" class="block text-xs font-medium text-slate-300 mb-1.5">Weight source</label>
      <select id="cookLogWeightSource" class="w-full rounded-lg bg-slate-800 ring-1 ring-slate-700 text-white text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-flame-500">
        <option value="scale">Weighed on a scale</option>
        <option value="estimated">Estimated</option>
      </select>
    </div>

    <button id="cookLogOptionalToggle" type="button" class="text-[11px] text-slate-400 hover:text-slate-300 underline underline-offset-2">
      Optional details
    </button>
    <div id="cookLogOptionalDetails" hidden class="space-y-3 pt-1">
      <div>
        <label for="cookLogTargetPitTemp" class="block text-xs font-medium text-slate-300 mb-1.5">Target pit temp (°F)</label>
        <input id="cookLogTargetPitTemp" type="number" inputmode="numeric" class="w-full rounded-lg bg-slate-800 ring-1 ring-slate-700 text-white text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-flame-500" />
      </div>
      <div>
        <label for="cookLogCookMethod" class="block text-xs font-medium text-slate-300 mb-1.5">Cook method</label>
        <select id="cookLogCookMethod" class="w-full rounded-lg bg-slate-800 ring-1 ring-slate-700 text-white text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-flame-500">
          <option value="">—</option>
          <option value="offset">Offset smoker</option>
          <option value="pellet">Pellet cooker</option>
          <option value="kamado">Kamado</option>
          <option value="oven">Oven</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div>
        <label for="cookLogAmbientTemp" class="block text-xs font-medium text-slate-300 mb-1.5">Ambient temp (°F)</label>
        <input id="cookLogAmbientTemp" type="number" inputmode="numeric" class="w-full rounded-lg bg-slate-800 ring-1 ring-slate-700 text-white text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-flame-500" />
      </div>
      <div>
        <label for="cookLogAltitude" class="block text-xs font-medium text-slate-300 mb-1.5">Altitude (ft)</label>
        <input id="cookLogAltitude" type="number" inputmode="numeric" class="w-full rounded-lg bg-slate-800 ring-1 ring-slate-700 text-white text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-flame-500" />
      </div>
    </div>

    <button type="submit" class="w-full rounded-lg bg-amber-500 hover:bg-amber-400 text-base-900 font-bold text-xs px-4 py-2.5 transition-colors">
      Track this cook
    </button>
    <button type="button" data-cook-log-opt-out class="text-[11px] text-slate-500 hover:text-slate-400 underline underline-offset-2">
      Stop sharing cook data
    </button>
  </form>

  <!-- Opted in, active cook -->
  <div id="cookLogCheckpoints" hidden class="space-y-3">
    <p id="cookLogActiveLabel" class="text-xs font-semibold text-emerald-400">Tracking this cook</p>

    <div class="grid grid-cols-3 gap-2">
      <button id="cookLogMarkWrapped" type="button" class="rounded-lg bg-slate-800 ring-1 ring-slate-700 hover:ring-flame-500/50 text-slate-300 hover:text-white text-xs font-semibold px-2 py-2 transition-all">Wrapped</button>
      <button id="cookLogMarkStallStart" type="button" class="rounded-lg bg-slate-800 ring-1 ring-slate-700 hover:ring-flame-500/50 text-slate-300 hover:text-white text-xs font-semibold px-2 py-2 transition-all">Stall start</button>
      <button id="cookLogMarkStallEnd" type="button" class="rounded-lg bg-slate-800 ring-1 ring-slate-700 hover:ring-flame-500/50 text-slate-300 hover:text-white text-xs font-semibold px-2 py-2 transition-all">Stall end</button>
    </div>

    <div id="cookLogFinishSection">
      <form id="cookLogFinishForm" class="flex gap-2 items-end">
        <div class="flex-1">
          <label for="cookLogFinalTemp" class="block text-xs font-medium text-slate-300 mb-1.5">Final internal temp (°F)</label>
          <input id="cookLogFinalTemp" type="number" inputmode="numeric" required class="w-full rounded-lg bg-slate-800 ring-1 ring-slate-700 text-white text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-flame-500" />
        </div>
        <button type="submit" class="shrink-0 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-base-900 font-bold text-xs px-4 py-2 transition-colors">Finished</button>
      </form>
    </div>

    <div id="cookLogRestSection" hidden>
      <form id="cookLogRestForm" class="flex gap-2 items-end">
        <div class="flex-1">
          <label for="cookLogRestMinutes" class="block text-xs font-medium text-slate-300 mb-1.5">Rest time (minutes)</label>
          <input id="cookLogRestMinutes" type="number" inputmode="numeric" required class="w-full rounded-lg bg-slate-800 ring-1 ring-slate-700 text-white text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-flame-500" />
        </div>
        <button type="submit" class="shrink-0 rounded-lg bg-slate-800 ring-1 ring-slate-700 hover:ring-flame-500/50 text-slate-300 hover:text-white text-xs font-semibold px-4 py-2 transition-all">Rested</button>
      </form>
    </div>

    <div class="flex items-center justify-between">
      <button id="cookLogDoneTracking" type="button" class="text-[11px] text-slate-500 hover:text-slate-400 underline underline-offset-2">
        Done tracking this cook
      </button>
      <button type="button" data-cook-log-opt-out class="text-[11px] text-slate-500 hover:text-slate-400 underline underline-offset-2">
        Stop sharing cook data
      </button>
    </div>
  </div>

  <p id="cookLogStatus" class="text-[11px] text-slate-500 min-h-[1em]" aria-live="polite"></p>
</div>
