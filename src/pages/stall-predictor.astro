---
import Layout from '../layouts/Layout.astro';
import StallPredictor from '../components/calc/StallPredictor.astro';
import FaqSection from '../components/calc/FaqSection.astro';
import { computeModel } from '../utils/stallEngine.js';
import { PROTEINS } from '../utils/proteinRegistry.js';

// Derive the "how long to smoke a brisket" figure from the engine so it can
// never drift from what the predictor computes (previously hardcoded prose).
const brisket12hTotal = computeModel(
  { weight: 12, pitTemp: 225, wrap: 'none', pit: 'offset_smoker', climate: 'moderate', wrapTemp: 160 },
  PROTEINS.beef_brisket
).totalTime;
const brisket12Lo = Math.round(brisket12hTotal * 0.9);
const brisket12Hi = Math.round(brisket12hTotal * 1.1);

const pageUrl = 'https://empiricalbbq.com/stall-predictor';
const publisher = {
  '@type': 'Organization',
  name: 'Empirical BBQ',
  url: 'https://empiricalbbq.com/',
  logo: 'https://empiricalbbq.com/android-chrome-512x512.png',
};
const faqs = [
  {
    q: 'How long does the brisket stall last?',
    a: 'The stall typically sets in between 150°F and 170°F and lasts roughly one to three hours unwrapped, depending on your pit’s airflow and humidity, the meat’s mass, and your climate. Wrapping in butcher paper shortens it, and foil can crush it almost entirely.',
  },
  {
    q: 'What causes the stall?',
    a: 'Evaporative cooling. As internal moisture migrates to the surface and evaporates, it pulls heat away about as fast as the pit adds it, so the internal temperature plateaus until the surface dries out.',
  },
  {
    q: 'Should I wrap to beat the stall?',
    a: 'Foil halts evaporation and powers through the stall fastest but softens the bark; peach butcher paper trims the stall while preserving bark; cooking naked gives the deepest bark but the longest stall. The predictor models all three wrap paths.',
  },
  {
    q: 'How does pit type affect the stall?',
    a: 'In this model, higher-airflow, drier pits — pellet cookers, kettles, and offsets — drive more evaporative cooling, which deepens and lengthens the stall. Low-airflow, higher-humidity cookers like ceramic kamados suppress evaporation, so their stall is shorter and milder — though their gentler convective heat makes the overall cook the longest. The predictor separates the two: stall duration and total cook time.',
  },
  {
    q: 'How long does it take to smoke a brisket?',
    a: `For a typical 12 lb brisket at 225°F on an offset smoker, expect roughly ${brisket12Lo} to ${brisket12Hi} hours to reach the 203°F finish, including the stall. Higher pit temperatures and wrapping shorten the total; the predictor plots the full internal-temperature curve.`,
  },
  {
    q: 'At what temperature does the brisket stall start?',
    a: 'Most commonly between 150°F and 170°F. The exact onset shifts with climate — drier air intensifies evaporative cooling and lowers it (nearer 145°F), while humid air suppresses evaporation and raises it (nearer 162°F).',
  },
  {
    q: 'Why is my brisket taking so long?',
    a: 'Usually the stall, amplified by a large or wide cut, a humid environment, or a low-airflow cooker. The predictor splits the cook into initial climb, stall, and final climb so you can see exactly where the time is going.',
  },
  {
    q: 'Can I log my actual cook time against the prediction?',
    a: 'Yes — the "Cook Log" panel below the results lets you opt in to track a real cook: it auto-fills the weight and prediction from this page, then lets you mark wrap, stall start/end, finish, and rest as they happen. It is off by default and anonymous — no name, email, or precise location, ever.',
  },
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Thermodynamic Stall Predictor',
    url: pageUrl,
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Any',
    description:
      'Model the evaporative-cooling stall: plot internal temperature versus time and predict stall duration from pit convection, humidity, wrap method, and meat mass.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title="Empirical BBQ | Brisket Stall Predictor & Cook-Time Curve"
  description="Model the evaporative-cooling stall: plot internal temperature versus time and predict stall duration from pit convection, humidity, wrap method, and meat mass."
  ogUrl="https://empiricalbbq.com/stall-predictor"
  favicon="📈"
  active="stall"
  schema={schema}
  bodyClass="page-stall min-h-screen bg-slate-950 text-slate-300 font-display antialiased"
>
  <StallPredictor />
  <FaqSection
    faqs={faqs}
    intro="The stall is the hours-long temperature plateau that frustrates every new pitmaster — and it is not your thermometer failing. It is evaporative cooling: as moisture wicks to the surface and evaporates, it pulls heat away about as fast as the pit adds it, so the internal temperature stalls until the surface dries. This predictor models exactly how long that plateau lasts for your cut, pit, wrap, and climate, so you can plan the cook around it instead of panicking through it."
  />
</Layout>
